SELECT
    RTRIM(n.NAVNUM) AS NAVIRE_NUM,
    RTRIM(n.NAVNOM) AS NAVIRE_NOM,
    es.ESCNUM AS ESCALE_NUM,
    RTRIM(es.NAVNUM) AS ESCALE_NAVNUM,
    RTRIM(m.MANNUM) AS MANIFESTE_NO,
    RTRIM(m.ESCNUM) AS MANIFESTE_ESCNUM,
    c.CNSNUM AS CONNAISSEMENT_NUM,
    RTRIM(c.CNSBLD) AS BL_NO,
    RTRIM(c.MANNUM) AS CNS_MANIFESTE_NO,
    RTRIM(c.CNSNNM) AS DESTINATAIRE,
    RTRIM(con.CONNOM) AS CONSIGNATAIRE,
    RTRIM(nat.NAMLIB) AS MARCHANDISE,
    RTRIM(cnd.CNDLIB) AS CONDITION_TRANSPORT,
    NVL(c.CNSNBC, 0) AS COLIS_MANIFESTE,
    NVL(deb.COLIS_DEBARQUE, 0) AS COLIS_DEBARQUE,
    NVL(c.CNSNBC, 0) - NVL(deb.COLIS_DEBARQUE, 0) AS RESTE_A_DEBARQUER
FROM ACONAGE.CONNAISSEMENT c
    JOIN ACONAGE.MANIFESTE m ON m.MANNUM = c.MANNUM
    JOIN ACONAGE.ESCALE es ON es.ESCNUM = m.ESCNUM
    JOIN ACONAGE.NAVIRE n ON RTRIM(n.NAVNUM) = RTRIM(es.NAVNUM)
    LEFT JOIN ACONAGE.NATURE nat ON RTRIM(nat.NAMCOD) = RTRIM(c.NAMCOD)
    LEFT JOIN ACONAGE.CONDITION cnd ON RTRIM(cnd.CNDCOD) = RTRIM(c.CNDCOD)
    LEFT JOIN ACONAGE.CONSIGNATAIRE con ON RTRIM(con.CONCOD) = RTRIM(es.CONCOD)
    LEFT JOIN
    (
        SELECT
            CNSNUM,
            SUM(NVL(DEBCOL, 0)) AS COLIS_DEBARQUE
        FROM ACONAGE.DEBARQUER
        GROUP BY CNSNUM
    ) deb ON deb.CNSNUM = c.CNSNUM
ORDER BY RTRIM(n.NAVNOM), RTRIM(m.MANNUM), RTRIM(c.CNSBLD)
