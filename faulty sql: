    SELECT CNSNUM, SUM(NVL(ENLCOL, 0)) AS COLIS_ENLEVE, MAX(ENLDAT) AS DERNIERE_DATE_ENL
    FROM ACONAGE.ENLEVEMENT
    GROUP BY CNSNUM
) enl ON enl.CNSNUM = c.CNSNUM
