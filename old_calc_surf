'=====================================
' MAIN SUB
'=====================================
Sub CalculateSurf()

    '=====================================
    ' VARIABLES
    '=====================================
    Dim ws          As Worksheet
    Dim wsRef       As Worksheet
    Dim lastRow     As Long
    Dim r           As Long
    
    ' Column indexes
    Dim colNbColis  As Long
    Dim colProduits As Long
    Dim colDetails  As Long
    Dim colSurf     As Long
    
    ' Header search
    Dim headerRow   As Long
    Dim cell        As Range
    Dim headerRange As Range
    
    '=====================================
    ' WORK ON ACTIVE SHEET
    '=====================================
    Set ws = ActiveSheet
    headerRow = 1
    
    '=====================================
    ' FIND COLUMNS BY HEADER NAME (Row 1)
    '=====================================
    Set headerRange = ws.Rows(headerRow)
    
    colNbColis = 0
    colProduits = 0
    colDetails = 0
    colSurf = 0
    
    For Each cell In headerRange.Cells
        If cell.Value = "" Then
            If cell.Column > 20 Then Exit For
        End If
        
        Select Case Trim(LCase(cell.Value))
            Case "nb colis", "nbcolis", "nb_colis", "nombre colis", "colis", "qte"
                colNbColis = cell.Column
            Case "produits", "produit", "product", "type"
                colProduits = cell.Column
            Case "Détails PRODUITS", "détails", "details", "detail", "détail"
                colDetails = cell.Column
            Case "surf", "surface", "surf (m2)", "surface (m2)"
                colSurf = cell.Column
        End Select
    Next cell
    
    '=====================================
    ' VALIDATE COLUMNS FOUND
    '=====================================
    Dim missingCols As String
    missingCols = ""
    
    If colNbColis = 0 Then missingCols = missingCols & "- Nb Colis" & vbNewLine
    If colProduits = 0 Then missingCols = missingCols & "- Produits" & vbNewLine
    If colDetails = 0 Then missingCols = missingCols & "- Details" & vbNewLine
    If colSurf = 0 Then missingCols = missingCols & "- Surf" & vbNewLine
    
    If missingCols <> "" Then
        MsgBox "Could not find these columns in Row 1:" & vbNewLine & vbNewLine & _
               missingCols & vbNewLine & _
               "Please make sure your headers match:" & vbNewLine & _
               "- Nb Colis" & vbNewLine & _
               "- Produits" & vbNewLine & _
               "- Details" & vbNewLine & _
               "- Surf", _
               vbCritical, "Missing Columns"
        Exit Sub
    End If
    
    '=====================================
    ' BUILD OR UPDATE REFERENCE SHEET
    '=====================================
    Set wsRef = Nothing
    
    On Error Resume Next
    Set wsRef = ThisWorkbook.Sheets("_RefCoeff")
    On Error GoTo 0
    
    If wsRef Is Nothing Then
        Set wsRef = ThisWorkbook.Sheets.Add
        wsRef.Name = "_RefCoeff"
        wsRef.Visible = xlSheetVeryHidden
    End If
    
    ' Clear and rebuild reference data
    wsRef.Cells.Clear
    wsRef.Range("A1").Value = "Produits"
    wsRef.Range("B1").Value = "Details"
    wsRef.Range("C1").Value = "Coefficient"
    

    
    ' Load reference data from function
    Dim refData As Variant
    refData = GetRefData()
    
    Dim i As Integer
    For i = 0 To UBound(refData)
        wsRef.Cells(i + 2, 1).Value = refData(i)(1) ' Column A (Produits) now gets refData(i)(1) -> "REMORQUE"
        wsRef.Cells(i + 2, 2).Value = refData(i)(0) ' Column B (Details) now gets refData(i)(0)  -> "REMORQUES"
        wsRef.Cells(i + 2, 3).Value = refData(i)(2) ' Column C (Coefficient) stays refData(i)(2) -> 24
        
        'wsRef.Cells(i + 2, 1).Value = CStr(refData(i)(1))
        'wsRef.Cells(i + 2, 2).Value = CStr(refData(i)(0))
        'wsRef.Cells(i + 2, 3).Value = CDbl(refData(i)(2))
        
    Next i
    
    '=====================================
    ' FIND LAST ROW IN ACTIVE SHEET
    '=====================================
    lastRow = ws.Cells(ws.Rows.Count, colNbColis).End(xlUp).Row
    
    If lastRow <= headerRow Then
        MsgBox "No data found below the header row.", _
               vbExclamation, "No Data"
        Exit Sub
    End If
    
    '=====================================
    ' CALCULATE SURF FOR EACH ROW
    '=====================================
    Dim nbColis      As Double
    Dim produit      As String
    Dim detail       As String
    Dim coeff        As Double
    Dim surfVal      As Variant
    Dim found        As Boolean
    Dim refLastRow   As Long
    Dim j            As Long
    Dim calcCount    As Long
    Dim skipCount    As Long
    Dim noMatchCount As Long
    
    refLastRow = wsRef.Cells(wsRef.Rows.Count, 1).End(xlUp).Row
    calcCount = 0
    skipCount = 0
    noMatchCount = 0
    
    Application.ScreenUpdating = False
    Application.Calculation = xlCalculationManual
    
    For r = headerRow + 1 To lastRow
    
        nbColis = 0
        produit = ""
        detail = ""
        
        ' Nb Colis must be numeric
        If IsNumeric(ws.Cells(r, colNbColis).Value) Then
            nbColis = CDbl(ws.Cells(r, colNbColis).Value)
        Else
            skipCount = skipCount + 1
            GoTo nextRow
        End If
        
        ' Produits & Details must not be empty
        produit = Trim(UCase(ws.Cells(r, colProduits).Value))
        detail = Trim(UCase(ws.Cells(r, colDetails).Value))
        
        If produit = "" Or detail = "" Then
            skipCount = skipCount + 1
            GoTo nextRow
        End If
        
        '=====================================
        ' LOOKUP COEFFICIENT
        '=====================================
        coeff = 0
        found = False
        
        Dim refProd As String
        Dim refDet  As String
        
        For j = 2 To refLastRow
            refProd = Trim(UCase(wsRef.Cells(j, 1).Value))
            refDet = Trim(UCase(wsRef.Cells(j, 2).Value))
            
            If refProd = produit And refDet = detail Then
                coeff = CDbl(wsRef.Cells(j, 3).Value)
                found = True
                Exit For
            End If
        Next j
        
        '=====================================
        ' WRITE SURF VALUE
        '=====================================
        If found Then
            surfVal = nbColis * coeff
            With ws.Cells(r, colSurf)
                .Value = surfVal
                .NumberFormat = "#,##0.00"
                .Interior.Color = RGB(198, 239, 206)
                .Font.Color = RGB(0, 97, 0)
                .Font.Bold = False
            End With
            calcCount = calcCount + 1
        Else
            With ws.Cells(r, colSurf)
                .Value = "N/A"
                .Interior.Color = RGB(255, 235, 156)
                .Font.Color = RGB(156, 101, 0)
                .Font.Bold = True
            End With
            noMatchCount = noMatchCount + 1
        End If
        
nextRow:
    Next r
    
    '=====================================
    ' RESTORE EXCEL SETTINGS
    '=====================================
    Application.ScreenUpdating = True
    Application.Calculation = xlCalculationAutomatic
    
    '=====================================
    ' DONE MESSAGE
    '=====================================
    MsgBox "Surf Calculation Complete!" & vbNewLine & vbNewLine & _
           "Sheet      : " & ws.Name & vbNewLine & _
           "Rows found : " & (lastRow - headerRow) & vbNewLine & _
           "Calculated : " & calcCount & vbNewLine & _
           "No match   : " & noMatchCount & vbNewLine & _
           "Skipped    : " & skipCount & vbNewLine & vbNewLine & _
           "Columns used:" & vbNewLine & _
           "- Nb Colis  > Col " & colNbColis & vbNewLine & _
           "- Produits  > Col " & colProduits & vbNewLine & _
           "- Details   > Col " & colDetails & vbNewLine & _
           "- Surf      > Col " & colSurf, _
           vbInformation, "Surf Calculator"

End Sub

'=====================================
' ADD BUTTON TO SHEET
'=====================================
Sub AddSurfButton()

    Dim ws  As Worksheet
    Dim shp As Shape
    Dim btn As Shape
    
    Set ws = ActiveSheet
    
    ' Remove existing button if any
    For Each shp In ws.Shapes
        If shp.Name = "BtnCalculSurf" Then shp.Delete
    Next shp
    
    ' Add new button
    Set btn = ws.Shapes.AddFormControl( _
        xlButtonControl, _
        ws.Cells(1, 1).Left, _
        ws.Cells(1, 1).Top, _
        160, 28)
    
    With btn
        .Name = "BtnCalculSurf"
        .TextFrame.Characters.Text = "Calculate Surf"
        .TextFrame.Characters.Font.Bold = True
        .TextFrame.Characters.Font.Size = 11
        .OnAction = "CalculateSurf"
    End With
    
    MsgBox "Button added to sheet: " & ws.Name, _
           vbInformation, "Button Added"

End Sub

'=====================================
' CLEAR SURF COLUMN
'=====================================
Sub ClearSurf()

    Dim ws          As Worksheet
    Dim cell        As Range
    Dim headerRange As Range
    Dim colSurf     As Long
    Dim lastRow     As Long
    
    Set ws = ActiveSheet
    Set headerRange = ws.Rows(1)
    colSurf = 0
    
    For Each cell In headerRange.Cells
        If cell.Value = "" And cell.Column > 20 Then Exit For
        Select Case Trim(LCase(cell.Value))
            Case "surf", "surface", "surf (m2)", "surface (m2)"
                colSurf = cell.Column
        End Select
    Next cell
    
    If colSurf = 0 Then
        MsgBox "Could not find 'Surf' column.", _
               vbCritical, "Column Not Found"
        Exit Sub
    End If
    
    lastRow = ws.Cells(ws.Rows.Count, colSurf).End(xlUp).Row
    
    If lastRow <= 1 Then
        MsgBox "No data to clear.", vbExclamation, "Empty"
        Exit Sub
    End If
    
    With ws.Range(ws.Cells(2, colSurf), ws.Cells(lastRow, colSurf))
        .ClearContents
        .Interior.ColorIndex = xlNone
        .Font.ColorIndex = xlAutomatic
        .Font.Bold = False
    End With
    
    MsgBox "Surf column cleared successfully!", _
           vbInformation, "Cleared"

End Sub
